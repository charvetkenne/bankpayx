



# =============================================================================
# 1. SECRETS & CONFIGURATIONS LOCALES (RÉCURSIF)
# =============================================================================
# Ignore TOUT fichier .env à n'importe quel niveau de profondeur
**/.env
**/.env.*
**/*.env
**/*.log
**/*.txt
!**/.env.example

# Ignore les surcharges de configuration Spring contenant des secrets locaux
**/application-local.yml
**/application-local.properties
**/application-dev.yml
**/application-secret.yml
**/docker-compose.override.yml

# Clés, certificats et keystores à n'importe quel endroit
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/secrets/
**/credentials.json

# =============================================================================
# 2. BACKEND (Spring Boot / Maven / Java) - RÉCURSIF
# =============================================================================
# Artefacts de build dans n'importe quel sous-projet
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear

# Fichiers générés par Maven
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next
**/release.properties
**/dependency-reduced-pom.xml
**/buildNumber.properties
**/.mvn/timing.properties
**/.mvn/wrapper/maven-wrapper.jar

# Logs d'application et de serveur
**/*.log
**/logs/
**/spring.log
**/hs_err_pid*.log

# =============================================================================
# 3. FRONTEND (Vite / React / Node.js) - RÉCURSIF
# =============================================================================
# Dépendances et caches à n'importe quel niveau
**/node_modules/
**/.vite/
**/.parcel-cache/

# Outputs de production
**/dist/
**/dist-ssr/
**/*.local

# Logs de gestionnaires de paquets
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-store/

# =============================================================================
# 4. DOCKER & INFRASTRUCTURE - RÉCURSIF
# =============================================================================
# Volumes de données locaux (pour ne pas commiter la DB ou Kafka locale)
**/postgres_data/
**/redpanda_data/
**/kafka-data/

# =============================================================================
# 5. IDE, OS & DIVERS - RÉCURSIF
# =============================================================================
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~

# =============================================================================
# 6. TESTS & COVERAGE - RÉCURSIF
# =============================================================================
**/coverage/
**/.nyc_output/
**/test-results/